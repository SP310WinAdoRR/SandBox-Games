# ==============================================================================
# CONFIGURACIÓN PREDETERMINADA - SANDBOX GAMES (default.env)
# ==============================================================================

# --- CATEGORÍAS MODO FÁCIL ---
FORCE_CATEGORY=MEDIA
TIME_CATEGORY=MEDIA
GRID_CATEGORY=MEDIA
ACTION_CATEGORY=AMBOS
BIMANUAL_CATEGORY=UNIMANUAL
TOLERANCE_CATEGORY=MEDIA

# --- PARÁMETROS NUMÉRICOS ESPECÍFICOS (MODO AVANZADO) ---
# Dimensiones iniciales de la cuadrícula
INITIAL_COLS=2
INITIAL_ROWS=2

# Escalado máximo de cuadrícula (1 = Fija 2x2, 2 = Hasta 4x2, 3 = Hasta 4x4)
MAX_GRID_STAGE=3

# Máximo de cuadrantes objetivo simultáneos por ronda (1 = Unimanual, 2 = Bimanual)
MAX_SIMULTANEOUS_TARGETS=1

# Tiempos límite por ronda (segundos)
BASE_TIME_LIMIT_SEC=15.0
MIN_TIME_LIMIT_SEC=7.0
TIME_DECAY_PER_ROUND=0.45
WIN_PAUSE_SEC=1.2
HOLD_TIME_SEC=0.6

# Umbrales de altura física requeridos (milímetros)
ELEVATE_THRESHOLD_MM=32.0
DIG_THRESHOLD_MM=-25.0
THRESHOLD_STEP_PER_ROUND_MM=1.5

# Tolerancia de nivelación entre rondas (milímetros)
FLAT_TOLERANCE_MM=7.0

# Visualización y Emulador
PIE_TIMER_OPACITY=75
EMULATOR_RATE_MM_S=55.0

# Configuración de red OSC (comunicación con motor de captura/proyección)
OSC_HOST=127.0.0.1
OSC_RX_PORT=7000
OSC_TX_PORT=7001
